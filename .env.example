# ==============================================================================
# AI Discovery Engine - Environment Configuration Template
# Copy this file to .env and fill in your actual API keys and secrets.
# ==============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=info
SECRET_KEY=change_this_to_a_random_secret_in_production

# Groq API Configuration (Obtain at: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL_EXTRACTION=llama-3.3-70b-versatile
GROQ_MODEL_FAST_FILTER=llama-3.1-8b-instant
GROQ_MODEL_SYNTHESIS=llama-3.3-70b-versatile

# Database & Cache Configurations
DATABASE_URL=postgresql://discovery_user:discovery_pwd@localhost:5432/discovery_db
VECTOR_DB_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0

# Rate Limiting & Harvesting Limits
MAX_REQUESTS_PER_MINUTE_REDDIT=30
MAX_REQUESTS_PER_MINUTE_PLAYSTORE=60
INGESTION_BATCH_SIZE=100
